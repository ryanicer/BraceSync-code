# BraceSync 部署环境变量模板
# 复制为 .env 并填入真实值（.env 不入库）
# 对齐：docs/ §2/§7

# ─── 数据库 ───────────────────────────────────────────────────
POSTGRES_USER=bracesync
POSTGRES_PASSWORD=<CHANGE_ME>
DB_URL=postgres://bracesync:<CHANGE_ME>@postgres:5432/bracesync?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=<CHANGE_ME>
REDIS_URL=redis://:<CHANGE_ME>@redis:6379/0

# ─── JWT / 安全 ──────────────────────────────────────────────
# 【必填，T039-H1】gateway/user-service 启动强校验：未设置时 gateway 拒绝启动（fail-closed），
# docker-compose 亦以 :? 语法拦截。必须替换为 256bit 随机值，禁止沿用占位符。
JWT_SECRET=<CHANGE_ME_256BIT_RANDOM>

# ─── 设备密钥列加密（device-service，AES-256-GCM，64 位 hex = 32 字节）───
DEVICE_SECRET_ENC_KEY=<CHANGE_ME_64_HEX_CHARS>

# ─── 手机号加密（user-service，AES-256-GCM，64 位 hex = 32 字节，T030）───
PHONE_ENC_KEY=<CHANGE_ME_64_HEX_CHARS>

# ─── 腾讯云 KMS（手机号加密）─────────────────────────────────
KMS_KEY_ID=<CHANGE_ME>
KMS_SECRET_ID=<CHANGE_ME>
KMS_SECRET_KEY=<CHANGE_ME>

# ─── 腾讯云 COS（文件存储）───────────────────────────────────
COS_SECRET_ID=<CHANGE_ME>
COS_SECRET_KEY=<CHANGE_ME>
COS_BUCKET=bracesync-12345678
COS_REGION=ap-guangzhou

# ─── 腾讯云 TCR（镜像仓库）──────────────────────────────────
TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_NAMESPACE=bracesync
TCR_USERNAME=<CHANGE_ME>
TCR_PASSWORD=<CHANGE_ME>

# ─── 微信小程序 ──────────────────────────────────────────────
WECHAT_APP_ID_PATIENT=<CHANGE_ME>
WECHAT_APP_SECRET_PATIENT=<CHANGE_ME>
WECHAT_APP_ID_TECH=<CHANGE_ME>
WECHAT_APP_SECRET_TECH=<CHANGE_ME>

# ─── 短信服务 ────────────────────────────────────────────────
SMS_SECRET_ID=<CHANGE_ME>
SMS_SECRET_KEY=<CHANGE_ME>
SMS_SDK_APP_ID=<CHANGE_ME>
SMS_SIGN_NAME=矫智通
SMS_TEMPLATE_ID=<CHANGE_ME>

# ─── 受控 mock 数据注入（T498，data-service）───────────────────
# 无硬件期造告警触发数据用。两键**默认全部留空**：留空 = 开关关 + 按生产对待。
#   APP_ENV            部署环境标记。只有 dev / test / staging 三个值算「非生产」（白名单，
#                      不是「非 production 即可」—— 拼成 prod/prodction 一律按生产处理）。
#   ALLOW_MOCK_INGEST  true 或 1 才开启 POST /internal/mock-frame；其它值与留空都是关。
# 🔴 生产两键一律留空。APP_ENV 非白名单 + ALLOW_MOCK_INGEST 已开 = data-service 启动即
#    log.Fatal（不给「起来了忘了关」留窗口），关着时该端点存在但每个请求 403。
# staging 用法：APP_ENV=staging + ALLOW_MOCK_INGEST=true → 重启 data-service → 注入验收
#    数据（落库带 ingest_source='mock' 印章 + 一行 audit_logs）→ 验收完删掉该键再重启。
APP_ENV=
ALLOW_MOCK_INGEST=

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_PASSWORD=<CHANGE_ME>

# ─── 镜像 Tag（CI 注入）──────────────────────────────────────
TAG=latest
