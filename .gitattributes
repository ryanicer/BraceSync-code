# 行尾统一（CI 红线防御，T013 新增）
# Dockerfile / shell / workflow 对行尾敏感，强制 LF，防止 Windows 编辑引入 CRLF 破坏 CI
*.sh text eol=lf
services/Dockerfile text eol=lf
.github/workflows/*.yml text eol=lf
# Go 源文件统一 LF（golangci-lint gofmt 检查基于 git blob 内容；
# Windows 开发环境 system autocrlf=true 会 checkout CRLF，导致 gofmt -s 误报）
*.go text eol=lf
# T164：前端 .ts/.vue/.js 一并 LF 归一化（与 *.go 同款；patient.ts 工作区 CRLF 污染 diff 噪音源）
apps/*/src/**/*.{ts,vue,js} text eol=lf
