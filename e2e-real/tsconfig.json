{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "../e2e/admin-helpers.ts"
  ],
  "exclude": ["playwright-report/**", "test-results/**", "node_modules/**"]
}
